FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
COPY frontend/ .
RUN rm -rf node_modules && npm ci
RUN npm run build -- --configuration production

FROM nginx:alpine
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
# Template nginx : ${BACKEND_INTERNAL_URL} sera remplacé au démarrage du conteneur
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template
# Script envsubst exécuté par nginx avant le démarrage (via /docker-entrypoint.d/)
COPY docker/nginx-envsubst.sh /docker-entrypoint.d/50-substitute-backend-url.sh
RUN chmod +x /docker-entrypoint.d/50-substitute-backend-url.sh
