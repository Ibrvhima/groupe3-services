# Configuration Django pour Docker
SECRET_KEY=django-insecure-docker-development-key-change-in-production
DEBUG=True

# Configuration de la base de données MySQL
SECRET_KEY=django-insecure-konakry-services-dev-key-changeme
DEBUG=True
DB_NAME=konakry_db
DB_USER=root
DB_PASSWORD=cherif
DB_HOST=localhost
DB_PORT=3306

# Configuration Redis
REDIS_URL=redis://redis:6379

# Configuration des noms d'hôtes Docker
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Configuration CORS pour développement
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000,http://127.0.0.1:4200